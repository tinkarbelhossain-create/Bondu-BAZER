<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>বন্ধু বাজার</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #16a34a;
      color: white;
      padding: 18px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
    }

    .search {
      padding: 12px 18px;
      width: 320px;
      max-width: 100%;
      border: none;
      border-radius: 25px;
      outline: none;
      font-size: 16px;
    }

    .hero {
      background: white;
      padding: 50px 20px;
      text-align: center;
    }

    .hero h1 {
      font-size: 38px;
      margin-bottom: 12px;
      color: #15803d;
    }

    .hero p {
      font-size: 18px;
      color: #555;
    }

    .categories {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      padding: 25px 15px;
    }

    .category {
      background: white;
      border: 1px solid #ddd;
      padding: 12px 20px;
      border-radius: 25px;
      cursor: pointer;
    }

    .category:hover {
      background: #16a34a;
      color: white;
    }

    .products {
      max-width: 1200px;
      margin: auto;
      padding: 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .product {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
      padding-bottom: 18px;
    }

    .product-image {
      height: 180px;
      background: #e5e7eb;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 55px;
    }

    .product-info {
      padding: 15px;
    }

    .product h3 {
      margin-bottom: 8px;
    }

    .price {
      color: #16a34a;
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 12px;
    }

    .order-btn {
      width: 100%;
      padding: 11px;
      border: none;
      border-radius: 8px;
      background: #16a34a;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }

    .order-btn:hover {
      background: #15803d;
    }

    footer {
      margin-top: 40px;
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
    }

    @media (max-width: 600px) {
      header {
        justify-content: center;
        text-align: center;
      }

      .hero h1 {
        font-size: 30px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">বন্ধু বাজার</div>

    <input
      type="text"
      class="search"
      placeholder="পণ্য খুঁজুন..."
      onkeyup="searchProducts()"
    >
  </header>

  <section class="hero">
    <h1>বন্ধু বাজারে স্বাগতম</h1>
    <p>আপনার প্রয়োজনীয় পণ্য সহজেই খুঁজে নিন এবং অর্ডার করুন</p>
  </section>

  <div class="categories">
    <button class="category">সব পণ্য</button>
    <button class="category">খাবার</button>
    <button class="category">গ্রোসারি</button>
    <button class="category">ফ্যাশন</button>
    <button class="category">ইলেকট্রনিক্স</button>
  </div>

  <section class="products" id="productList">

    <div class="product">
      <div class="product-image">🍚</div>
      <div class="product-info">
        <h3>চাল</h3>
        <div class="price">৳ ৮০ / কেজি</div>
        <button class="order-btn" onclick="orderProduct('চাল')">
          অর্ডার করুন
        </button>
      </div>
    </div>

    <div class="product">
      <div class="product-image">🍎</div>
      <div class="product-info">
        <h3>ফল</h3>
        <div class="price">৳ ২০০</div>
        <button class="order-btn" onclick="orderProduct('ফল')">
          অর্ডার করুন
        </button>
      </div>
    </div>

    <div class="product">
      <div class="product-image">🍔</div>
      <div class="product-info">
        <h3>বার্গার</h3>
        <div class="price">৳ ২৫০</div>
        <button class="order-btn" onclick="orderProduct('বার্গার')">
          অর্ডার করুন
        </button>
      </div>
    </div>

    <div class="product">
      <div class="product-image">👕</div>
      <div class="product-info">
        <h3>টি-শার্ট</h3>
        <div class="price">৳ ৫৫০</div>
        <button class="order-btn" onclick="orderProduct('টি-শার্ট')">
          অর্ডার করুন
        </button>
      </div>
    </div>

  </section>

  <footer>
    © 2026 বন্ধু বাজার — আপনার অনলাইন বাজার
  </footer>

  <script>
    function orderProduct(productName) {
      alert(productName + " অর্ডার করার জন্য নির্বাচন করা হয়েছে।");
    }

    function searchProducts() {
      const search =
        document.querySelector(".search").value.toLowerCase();

      const products =
        document.querySelectorAll(".product");

      products.forEach(function(product) {
        const name =
          product.querySelector("h3").innerText.toLowerCase();

        if (name.includes(search)) {
          product.style.display = "block";
        } else {
          product.style.display = "none";
        }
      });
    }
  </script>

</body>
</html>
